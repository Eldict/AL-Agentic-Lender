# Copy to .env and fill in. Never commit .env.
# All are optional: anything missing is skipped and the demo still runs.

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local Ollama server (default shown)
OLLAMA_HOST=http://localhost:11434

# Firebase service account JSON (Firebase console > Project settings > Service accounts)
# Keep the file OUTSIDE the repo or name it *service-account*.json (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=
